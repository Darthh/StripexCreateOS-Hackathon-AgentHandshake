{
  "files": {
    "includes": [
      "**",
      "!dist",
      "!node_modules",
      "!.wrangler",
      "!.projects",
      "!.agents",
      "!.claude",
      "!.cursor",
      "!worker/embedded.gen.ts",
      "!build",
      "!pricing.html",
      "!pricing2.html"
    ]
  },
  "linter": {
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noExplicitAny": "off"
      }
    }
  },
  "formatter": {
    "enabled": false
  }
}
