#!/bin/sh
# 1. No secret files may ever be tracked (the Stripe Projects CLI rewrites .gitignore).
tracked=$(git ls-files | grep -E '(^|/)\.env($|\.)|^\.projects/|(^|/)\.dev\.vars' | grep -v '\.env\.example$')
if [ -n "$tracked" ]; then echo "pre-push: refusing, secret files are tracked:"; echo "$tracked"; exit 1; fi
# 2. No secret in any commit being pushed.
command -v gitleaks >/dev/null || { echo "pre-push: install gitleaks (https://github.com/gitleaks/gitleaks)"; exit 1; }
exec gitleaks git --redact --no-banner
